# Supported runtime (export these into the service process)
DEPLAI_SERVICE_KEY=
OPENROUTER_API_KEY=
UIUX_RUN_DIRECTORY=./data/uiux-runs
UIUX_CONNECTOR_URL=http://127.0.0.1:3000
# Defaults to openrouter/free (200K context). Override with an exact :free ID if needed.
UIUX_OPENROUTER_MODEL=openrouter/free

# Legacy Agno scaffold only; unused by the supported Docker entrypoint
# --- LLM Provider ---
# Large model for design system authoring + component refactoring
ANTHROPIC_API_KEY=
# Optionally override the default model IDs
# STRONG_MODEL=anthropic:claude-sonnet-4-20250514
# SMALL_MODEL=anthropic:claude-haiku-3-20240307

# --- MongoDB (Tier 0: local mongod) ---
MONGO_DB_URL=mongodb://localhost:27017
MONGO_DB_NAME=agno

# --- Target Repository ---
# Absolute or relative path to the project root (not its src/ directory)
TARGET_REPO_ROOT=../Connector

# --- Agno Telemetry ---
# Closes the one outbound channel the SDK opens by default
AGNO_TELEMETRY=false

# --- AgentOS ---
AGENTOS_PORT=7777
