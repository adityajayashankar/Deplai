# env files
.env
.env.local
Agentic Layer/.env

# dependencies
Connector/node_modules
admin-console/node_modules/
Connector/.pnp
Connector/.pnp.*
Connector/.yarn/*
!Connector/.yarn/patches
!Connector/.yarn/plugins
!Connector/.yarn/releases
!Connector/.yarn/versions
Connector/package-lock.json
terraforge/

# testing
Connector/coverage
admin-console/coverage/

# next.js
Connector/.next/
Connector/out/
admin-console/.next/
admin-console/out/

# production
Connector/build
admin-console/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
runtime/
Agentic Layer/runtime/
.deplai_runtime/
Agentic Layer/.deplai_runtime/

# vercel
Connector/.vercel
admin-console/.vercel

# typescript
*.tsbuildinfo
Connector/next-env.d.ts
admin-console/next-env.d.ts

# runtime data (cloned repos & uploaded projects) — keep directory structure via .gitkeep
Connector/tmp/repos/*
!Connector/tmp/repos/.gitkeep
Connector/tmp/local-projects/*
!Connector/tmp/local-projects/.gitkeep
tmp_inspect/

# Python
__pycache__/
*.pyc
*.pyo

# Claude Code
.claude/
.skill/
remediation-plan.md
Terraform-generation-plan.md
.opencode/

*.json
*.jsonl
*.mjs
*.map

# Allow admin console source/config files hidden by the broad artifact ignores.
!admin-console/package.json
!admin-console/package-lock.json
!admin-console/tsconfig.json
!admin-console/postcss.config.mjs
!admin-console/scripts/start-server.mjs
!admin-console/scripts/server-boundary.mjs

# Allow tracked config/source artifacts in Customization Agent
!Customization Agent/**/*.json
!Customization Agent/**/*.jsonl
!Customization Agent/**/*.mjs

# Terraform Agent internal registry (catalog + module contracts)
!Terraform Agent/agent/internal_registry/catalog.json
!Terraform Agent/agent/internal_registry/contracts/*.json

# Customization Agent runtime artifacts
Customization Agent/SubSpace-*
Customization Agent/CulturePlace-main/frontend/.env.local
Customization Agent/tenant_builder_app/backend/logs/customization.log
Customization Agent/tenant_builder_app/backend/logs/previews/
Customization Agent/tenant_builder_app/backend/tenants/

# KGagent data and config files — needed as Neo4j fallback and for agent config
!KGagent/**/*.json
!KGagent/**/*.jsonl

#IDEA IDE
.idea/
.kiro/

# Temp folders
tmp/
temp_tf_fmt_check/
Plans/
