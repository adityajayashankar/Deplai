# Admin console — private owner control plane (port 3100, localhost only)
ADMIN_ENABLED=true
ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=3100
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret
ADMIN_AUDIT_HMAC_SECRET=change-me-to-a-different-long-random-secret
ADMIN_MFA_ENCRYPTION_KEY=change-me-to-yet-another-long-random-secret
ADMIN_SESSION_IDLE_MINUTES=15
ADMIN_SESSION_ABSOLUTE_HOURS=4
ADMIN_STEP_UP_MINUTES=5
ADMIN_ALLOW_UNSAFE_BIND=false

# Shared Deplai database (read/write through admin services only)
# If unset, `npm run migrate` / `npm run admin:bootstrap` also read ../Connector/.env.local for DB_* values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=deplai

# Razorpay (for refund operations from admin console)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test

# WebAuthn RP ID (localhost in dev)
ADMIN_WEBAUTHN_RP_ID=localhost
ADMIN_WEBAUTHN_RP_NAME=Deplai Owner Console
ADMIN_WEBAUTHN_ORIGIN=http://127.0.0.1:3100
