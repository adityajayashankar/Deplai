# DeplAI shared environment template
# Copy this file to .env and replace placeholder values.

# Core required
DEPLAI_SERVICE_KEY=change-me
WS_TOKEN_SECRET=change-me
SESSION_SECRET=change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
AGENTIC_LAYER_URL=http://localhost:8001

# Connector GitHub OAuth/App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional: local/test app install button (slug from github.com/apps/<slug>)
NEXT_PUBLIC_GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=

# Connector + Agentic shared runtime
NEXT_PUBLIC_AGENTIC_WS_URL=ws://localhost:8000
ALLOW_GLOBAL_CLEANUP=false
DEPLAI_LOCAL_PROJECTS_ROOT=
DEPLAI_GITHUB_REPOS_ROOT=
HOST_PROJECTS_DIR=
CORS_ORIGINS=http://localhost:3000

# Connector database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=deplai

# Connector admin/workspace controls
# Login emails that can call admin APIs (grants, refunds, fulfillments).
# This does not grant extra credits while BILLING_ENFORCEMENT=false.
ADMIN_EMAILS=
ADMIN_EMAIL=
ADMIN_ACCESS_KEY=
CLEANUP_SCAN_VOLUMES_ON_LOGOUT=false

# AWS runtime/cost
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEPLAI_FREE_TIER_EC2_TYPES=t3.micro,t2.micro
DEPLAI_ALLOW_EC2_DISABLE_FALLBACK=1
DEPLAI_EC2_INSTANCE_TYPE=

# LLM provider keys/models
# ANTHROPIC_API_KEY / CLAUDE_API_KEY: Required for LLM-backed Terraform parameter
# selection in param_selector.py. When neither is set, the param selector falls back
# to deterministic slug-based defaults derived from the project name.
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
# Override the Claude model used by the IaC param selector (default: claude-sonnet-4-5):
# IAC_PARAM_SELECTOR_MODEL=claude-sonnet-4-5
CLAUDE_MODEL=claude-3-7-sonnet-latest
CLAUDE_REPO_ANALYZER_MODEL=claude-3-5-haiku-20241022
CLAUDE_REVIEW_QUESTION_MODEL=claude-3-5-haiku-20241022
CLAUDE_INFRA_PLANNER_MODEL=
DEPLAI_CLAUDE_MAX_PIPELINE_COST_USD=3.0
DEPLAI_CLAUDE_MAX_TERRAFORM_GEN_COST_USD=1.0

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Multi-provider AI platform (Connector control plane)
AI_PLATFORM_ENABLED=true
AI_BYOK_ENABLED=true
AI_MODEL_SYNC_ENABLED=true
AI_ROUTING_ENABLED=true
AI_FALLBACK_ENABLED=true
AI_PLAYGROUND_ENABLED=true
AI_DEFAULT_ACCESS_MODE=auto
AI_DEFAULT_ROUTING_POLICY=default
AI_ENABLE_CROSS_PROVIDER_FALLBACK=true
# Optional dedicated key for BYOK encryption at rest. Falls back to SESSION_SECRET.
AI_CREDENTIAL_ENCRYPTION_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
MINIMAX_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
GLM_API_KEY=
ZAI_API_KEY=
# Internal services call the Connector gateway with DEPLAI_SERVICE_KEY.
DEPLAI_AI_GATEWAY_URL=http://localhost:3000
AI_PROVIDER_OPENAI_ENABLED=true
AI_PROVIDER_ANTHROPIC_ENABLED=true
AI_PROVIDER_MINIMAX_ENABLED=true
AI_PROVIDER_XAI_ENABLED=true
AI_PROVIDER_GEMINI_ENABLED=true
AI_PROVIDER_KIMI_ENABLED=true
AI_PROVIDER_GLM_ENABLED=true
AI_PROVIDER_GROQ_ENABLED=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=deplai-agentic

OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional misc
PUTTYGEN_PATH=
CUSTOMIZATION_AGENT_BASE_URL=http://127.0.0.1:8010
CUSTOMIZATION_BACKEND_URL=http://127.0.0.1:8010
# Optional AgentOS UI/UX refactor service. The customization UI uses these
# values server-side; do not expose them as NEXT_PUBLIC variables.
UIUX_AGENT_BASE_URL=http://127.0.0.1:7777
UIUX_AGENT_WORKFLOW_ID=uiux-refactor-agent
CONTAINER_OP_TIMEOUT=120
SCANNER_TIMEOUT_SECONDS=1800
GRYPE_TIMEOUT_SECONDS=900
ZAP_IMAGE=zaproxy/zap-stable:2.16.1
DAST_TIMEOUT_SECONDS=900
DAST_SPIDER_MINUTES=5
DAST_MAX_CONCURRENT=3
# DAST outbound HTTP (plain) is off in production. Set true only for local HTTP targets.
DAST_ALLOW_HTTP=false
DAST_VERIFICATION_TTL_DAYS=90
DAST_GRANT_TTL_SECONDS=900
# Optional dedicated HMAC secret; defaults to DEPLAI_SERVICE_KEY
# DAST_AUTHZ_SECRET=
CONNECTOR_URL=http://localhost:3000

# Application deployment execution (EC2 + Docker + ECR + SSM)
# Keep SSH off. The executor talks to instances through Systems Manager.
DEPLOY_EXEC_ADAPTER=ssm
DEPLOY_EXEC_ALLOW_SSH=0
DEPLOY_EXEC_SKIP_TAG_CHECK=0

# Optional remediation tuning
REMEDIATION_LLM_BACKEND=auto
REMEDIATION_MAX_CONTEXT_FILES=12
REMEDIATION_MAX_PATCH_FILES=10
REMEDIATION_CODE_ROOT_CAUSES_PER_BATCH=4
REMEDIATION_SUPPLY_ROOT_CAUSES_PER_BATCH=4
REMEDIATION_MAX_BATCHES_PER_CYCLE=4
REMEDIATION_LARGE_FINDING_THRESHOLD=1000
REMEDIATION_PIPELINE_GROUPS_PER_BATCH=8
REMEDIATION_PIPELINE_MAX_GROUPS_LARGE=6
REMEDIATION_PIPELINE_MAX_VULNS_PER_GROUP_LARGE=8
REMEDIATION_SNIPPET_MAX_BUNDLE_CHARS=6000
REMEDIATION_SAST_CONTEXT_LINES=12
REMEDIATION_SCA_CONTEXT_LINES=2
REMEDIATION_IMPORT_CONTEXT_LINES=12
REMEDIATION_LLM_TIMEOUT_SECONDS=120
REMEDIATION_MAX_COMPLETION_TOKENS=2048
DEPLAI_MAX_REMEDIATION_COST_USD=1.0

# Stripe billing (unused — Razorpay is the live checkout)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Razorpay billing. UI prices stay in USD; charges are INR at RAZORPAY_USD_TO_INR plus GST.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_USD_TO_INR=83

# GST tax invoice seller snapshot (required before live Indian billing)
BILLING_LEGAL_NAME=DeplAI
BILLING_GSTIN=
BILLING_ADDRESS=
BILLING_STATE_NAME=Karnataka
BILLING_STATE_CODE=29
BILLING_SAC_CODE=998314
BILLING_INVOICE_PREFIX=DPL
BILLING_GST_RATE=18

# Leave false until Razorpay checkout is live. Features stay open to every signed-in user.
# Reported credit balances stay $0 until this is true.
BILLING_ENFORCEMENT=false
NEXT_PUBLIC_BILLING_ENFORCEMENT=false

# IaC pipeline tuning
IAC_MAX_VALIDATION_RETRIES=3
IAC_WORKSPACE_ROOT=/tmp/deplai-workspaces
IAC_WORKSPACE_TTL_HOURS=24
IAC_TERRAFORM_PARALLELISM=10
