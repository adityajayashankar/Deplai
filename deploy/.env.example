# Copy to deploy/.env, set every placeholder, then keep deploy/.env off Git.
# Start with:
# docker compose --env-file deploy/.env -f docker-compose.production.yml up -d --build

# Public domain. Its DNS A record must resolve to this EC2 instance.
APP_DOMAIN=deplai.tech
NEXT_PUBLIC_APP_URL=https://deplai.tech
# Caddy terminates TLS and proxies this route to FastAPI with WebSocket upgrades.
NEXT_PUBLIC_AGENTIC_WS_URL=wss://deplai.tech/agentic
CORS_ORIGINS=https://deplai.tech

# Docker image tags. Pin these to approved digests before a regulated launch.
CADDY_IMAGE=caddy:2.8.4-alpine
MYSQL_IMAGE=mysql:8.4
QDRANT_IMAGE=qdrant/qdrant:v1.13.6

# Required shared secrets. Generate each independently, for example:
# openssl rand -hex 32
DEPLAI_SERVICE_KEY=replace-with-64-random-hex-characters
WS_TOKEN_SECRET=replace-with-a-different-64-random-hex-characters
SESSION_SECRET=replace-with-a-different-64-random-hex-characters
ADMIN_EMAILS=you@your-domain.com
ADMIN_ACCESS_KEY=replace-with-a-different-64-random-hex-characters
# Private admin console secrets. Generate each independently; they must remain
# only in deploy/.env or the configured secret manager.
ADMIN_SESSION_SECRET=
ADMIN_AUDIT_HMAC_SECRET=
ADMIN_MFA_ENCRYPTION_KEY=
ALLOW_GLOBAL_CLEANUP=false

# MySQL is internal-only. MYSQL_PASSWORD and MYSQL_ROOT_PASSWORD must differ.
MYSQL_DATABASE=deplai
MYSQL_USER=deplai
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# GitHub OAuth App and GitHub App. Supply the private key as a single-line
# base64 string: base64 -w0 github-app-private-key.pem
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=https://deplai.tech/api/webhooks/github
GITHUB_APP_NAME=
# Browser GitHub App install button (baked into the Connector image at build).
NEXT_PUBLIC_GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_APP_INSTALL_URL=

# Required by the Agentic Layer Docker SDK. On the Linux host run:
# stat -c '%g' /var/run/docker.sock
DOCKER_GID=998

# Cloud integrations. Leave AWS values empty only when AWS apply/runtime
# functionality is intentionally disabled.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Configure one or more model providers used by Agentic/Customization services.
# The Connector AI platform is the control plane. Platform keys below are used
# as shared credentials; customers can also attach BYOK keys in the UI.
AI_PLATFORM_ENABLED=true
AI_BYOK_ENABLED=true
# openssl rand -hex 32 — keep this stable; rotating it invalidates stored BYOK secrets.
AI_CREDENTIAL_ENCRYPTION_KEY=
DEPLAI_AI_GATEWAY_URL=http://connector:3000
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MINIMAX_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
GLM_API_KEY=
ZAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-7-sonnet-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=deplai-agentic
# Optional Atlas remediation journal. Use a database user limited to this DB.
# Keep the URI only in deploy/.env or your secret manager, never in Git.
# Empty uses private persistent security-mongo. Set only for an external database.
# Existing external history is not migrated automatically.
MONGODB_URI=
REMEDIATION_MONGODB_DATABASE=deplai_security
REMEDIATION_MONGODB_RETENTION_DAYS=30
# These persist curated source context in LangGraph checkpoints. They are
# automatically disabled for direct BYOK keys, and default to false.
REMEDIATION_MONGODB_CHECKPOINTS=false
REMEDIATION_MONGODB_PERSIST_CONTEXT=false
# Conservative shared-key guard for OpenRouter free, MiniMax M3/M2.7, and
# Nemotron remediation traffic. Requests reserve input + max output tokens.
# Keep the request cap below 8K unless the upstream provider contract changes.
OPENROUTER_LOW_QUOTA_REQUEST_TOKEN_CAP=7500
OPENROUTER_LOW_QUOTA_RPM=8
OPENROUTER_LOW_QUOTA_TPM=60000
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:7b

# Scan, remediation, and Terraform limits.
# Aggregate worker-request allowance; model context and provider quota are separate.
REMEDIATION_RUN_TOKEN_BUDGET=2000000
REMEDIATION_SUPERVISOR_MAX_PACKETS=256
SCANNER_TIMEOUT_SECONDS=1800
GRYPE_TIMEOUT_SECONDS=900
CONTAINER_OP_TIMEOUT=120
REMEDIATION_MAX_COMPLETION_TOKENS=2048
# Applies only to MiniMax M3/M2.7 and Nemotron OpenRouter remediation paths.
REMEDIATION_OPENROUTER_PLANNER_MAX_TOKENS=512
REMEDIATION_OPENROUTER_IMPLEMENTOR_MAX_TOKENS=1800
REMEDIATION_LOCAL_REVIEW_MIN_SCORE=80
DEPLAI_MAX_REMEDIATION_COST_USD=1.0
DEPLAI_CLAUDE_MAX_PIPELINE_COST_USD=3.0
IAC_WORKSPACE_TTL_HOURS=24
DAST_ALLOW_HTTP=false

# Leave false until Razorpay checkout is live. Every signed-in user gets the
# full product. Checkout still returns 501 when Razorpay keys are empty.
BILLING_ENFORCEMENT=false
NEXT_PUBLIC_BILLING_ENFORCEMENT=false

# Razorpay is configured only at Connector runtime. Keep both secrets out of
# Docker build args and browser-prefixed variables. Test checkout is fixed at
# INR 1.00 (100 paise); live mode refuses to start checkout until the override
# is explicitly disabled and a matching rzp_live_ key is supplied.
PAYMENTS_ENABLED=true
PAYMENTS_PROVIDER=razorpay
PAYMENTS_MODE=test
PAYMENTS_TEST_AMOUNT_OVERRIDE=true
PAYMENTS_TEST_AMOUNT_PAISE=100
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_USD_TO_INR=95
BILLING_GST_RATE=18
CREDIT_METERING_MODE=off
CREDIT_MODEL_PRICING_MAX_AGE_HOURS=720
BILLING_LEGAL_NAME=DeplAI
BILLING_GSTIN=
BILLING_ADDRESS=
BILLING_STATE_NAME=Karnataka
BILLING_STATE_CODE=29
BILLING_SAC_CODE=998314
BILLING_INVOICE_PREFIX=DPL
# Configure this exact public HTTPS endpoint in Razorpay Dashboard:
# https://deplai.tech/api/webhooks/razorpay
