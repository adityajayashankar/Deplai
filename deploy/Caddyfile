{
    admin off
}

{$APP_DOMAIN} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Customization previews are embedded by the same-origin dashboard.
    @customization_preview path /api/customization/preview/*
    header @customization_preview {
        X-Frame-Options "SAMEORIGIN"
        Content-Security-Policy "frame-ancestors 'self'"
    }

    # Keep every other application response protected from framing.
    @not_customization_preview not path /api/customization/preview/*
    header @not_customization_preview X-Frame-Options "DENY"

    # Browser WebSockets only. HTTP Agentic APIs stay on the Docker network
    # and are called by Connector with X-API-Key. Strip /agentic so FastAPI
    # still receives /ws/scan|remediate|pipeline/...
    @agentic_ws path /agentic/ws /agentic/ws/*
    handle @agentic_ws {
        uri strip_prefix /agentic
        reverse_proxy agentic-layer:8000
    }

    handle {
        reverse_proxy connector:3000
    }
}
