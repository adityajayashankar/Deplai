{
    admin off
}

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
    @www host www.{$APP_DOMAIN}
    handle @www {
        redir https://{$APP_DOMAIN}{uri} permanent
    }

    @not_agentic_ws not path_regexp ^/agentic/ws
    encode @not_agentic_ws zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @customization_preview path /api/customization/preview/*
    header @customization_preview {
        X-Frame-Options "SAMEORIGIN"
        Content-Security-Policy "frame-ancestors 'self'"
    }

    @not_customization_preview not path /api/customization/preview/*
    header @not_customization_preview X-Frame-Options "DENY"

    # Browser WebSockets only (scan, remediate, pipeline live logs).
    #
    # Browser:  wss://{$APP_DOMAIN}/agentic/ws/scan/{project_id}?token=...
    # Caddy:    strip "/agentic" only
    # Agentic:  /ws/scan/{project_id}
    #
    # Correct:  handle_path /agentic/*  OR  uri strip_prefix /agentic
    # Wrong:    handle_path /agentic/ws/* (strips "/agentic/ws" -> "/scan/{id}")
    @agentic_browser_ws path_regexp ^/agentic/ws
    handle @agentic_browser_ws {
        uri strip_prefix /agentic
        reverse_proxy agentic-layer:8000 {
            flush_interval -1
            transport http {
                versions 1.1
            }
        }
    }

    handle {
        reverse_proxy connector:3000
    }
}
