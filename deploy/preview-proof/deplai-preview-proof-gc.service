[Unit]
Description=Collect expired DeplAI synthetic proof resources
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/deplai-preview-proof/run_proof.py --root /var/lib/deplai-preview-proof --gc
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/deplai-preview-proof
