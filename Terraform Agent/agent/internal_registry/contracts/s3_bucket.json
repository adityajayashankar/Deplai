{
  "service": "s3_bucket",
  "kind": "module",
  "module_source": "terraform-aws-modules/s3-bucket/aws",
  "module_version": "4.11.0",
  "provider_constraint": ">= 5.83, < 6.0",
  "blocked_newer": {
    "version": "5.15.4",
    "provider_constraint": ">= 6.42",
    "reason": "Incompatible with curated EC2 5.8.x + ALB 9.x stack on AWS provider 5.x"
  },
  "allowed_args": [
    "bucket",
    "bucket_prefix",
    "acl",
    "force_destroy",
    "acceleration_status",
    "request_payer",
    "website",
    "cors_rule",
    "versioning",
    "logging",
    "grant",
    "owner",
    "expected_bucket_owner",
    "lifecycle_rule",
    "replication_configuration",
    "server_side_encryption_configuration",
    "intelligent_tiering",
    "object_lock_configuration",
    "object_lock_enabled",
    "block_public_acls",
    "block_public_policy",
    "ignore_public_acls",
    "restrict_public_buckets",
    "control_object_ownership",
    "object_ownership",
    "attach_policy",
    "attach_deny_insecure_transport_policy",
    "attach_require_latest_tls_policy",
    "attach_deny_incorrect_encryption_headers",
    "attach_deny_incorrect_kms_key_sse",
    "attach_deny_unencrypted_object_uploads",
    "allowed_kms_key_arn",
    "policy",
    "tags",
    "create_bucket"
  ],
  "forbidden_args": [],
  "edit_schema": {
    "force_destroy": {"type": "bool"},
    "versioning": {"type": "object"},
    "tags": {"type": "map"}
  },
  "notes": "Use 4.11.0 on AWS provider 5.x. Registry latest 5.15.4 needs aws >= 6.42 — do not adopt until EC2/ALB migrate to provider 6."
}
